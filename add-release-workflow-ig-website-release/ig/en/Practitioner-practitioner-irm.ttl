# - resource -------------------------------------------------------------------

<https://hl7.fr/ig/fhir/preadmission/Practitioner/practitioner-irm> a fhir:Practitioner ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "practitioner-irm"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-practitioner" ;
       fhir:index -1 ;
       fhir:link <https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-practitioner>
     ]
  ] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Practitioner practitioner-irm</b></p><a name=\"practitioner-irm\"> </a><a name=\"hcpractitioner-irm\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"https://hl7.fr/ig/fhir/core/2.2.0/StructureDefinition-fr-core-practitioner.html\">FR Core Practitioner Profile</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Sophie Martin (http://example.com/practitioner-ids#IRM-001)</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Administrative gender\">Gender:</td><td colspan=\"3\">Female</td></tr></table></div>"
  ] ;
  fhir:Practitioner.identifier [
     fhir:index -1 ;
     fhir:Identifier.system [ fhir:value "http://example.com/practitioner-ids" ] ;
     fhir:Identifier.value [ fhir:value "IRM-001" ]
  ] ;
  fhir:Practitioner.name [
     fhir:index -1 ;
     fhir:HumanName.family [ fhir:value "Martin" ] ;
     fhir:HumanName.given [
       fhir:value "Sophie" ;
       fhir:index -1
     ]
  ] ;
  fhir:Practitioner.gender [ fhir:value "female"] .

# - ontology header ------------------------------------------------------------

<https://hl7.fr/ig/fhir/preadmission/Practitioner/practitioner-irm.ttl> a owl:Ontology ;
