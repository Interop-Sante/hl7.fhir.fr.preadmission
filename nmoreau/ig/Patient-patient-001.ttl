@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.fr/fhir/fr/preadmission/Patient/patient-001> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "patient-001"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-patient"^^xsd:anyURI ;
       fhir:link <https://hl7.fr/ig/fhir/core/StructureDefinition/fr-core-patient>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Patient de préadmission - référencé dans les autres exemples.</p></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:identifier ( [
     fhir:system [ fhir:v "http://interopsante.org/fhir/NIR"^^xsd:anyURI ] ;
     fhir:value [ fhir:v "123456789012345" ]
  ] ) ; # 
  fhir:name ( [
     fhir:use [ fhir:v "official" ] ;
     fhir:family [ fhir:v "Dupont" ] ;
     fhir:given ( [ fhir:v "Jean" ] )
  ] ) ; # 
  fhir:gender [ fhir:v "male"] ; # 
  fhir:birthDate [ fhir:v "1980-01-01"^^xsd:date] . # 

# -------------------------------------------------------------------------------------

