# - resource -------------------------------------------------------------------

<http://hl7.fr/fhir/fr/preadmission/Questionnaire/questionnaire-irm> a fhir:Questionnaire ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "questionnaire-irm"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Réponse du patient au questionnaire posé lors de la prise de rendez-vous pour une IRM.</p></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:url [ fhir:v "http://hl7.fr/fhir/fr/preadmission/Questionnaire/questionnaire-irm"^^xsd:anyURI] ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:title [ fhir:v "Questionnaire IRM - Préadmission"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:subjectType ( [ fhir:v "Patient"] ) ; # 
  fhir:date [ fhir:v "2025-05-14T09:00:47+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "Interop'Santé"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "Interop'Santé" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://interopsante.org/" ]
     ] )
  ] [
     fhir:name [ fhir:v "InteropSanté" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "email" ] ;
       fhir:value [ fhir:v "fhir@interopsante.org" ] ;
       fhir:use [ fhir:v "work" ]
     ] )
  ] ) ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "urn:iso:std:iso:3166"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "FR" ] ;
       fhir:display [ fhir:v "FRANCE" ]
     ] )
  ] ) ; # 
  fhir:item ( [
     fhir:linkId [ fhir:v "implant" ] ;
     fhir:text [ fhir:v "Avez-vous un implant métallique ou un pacemaker ?" ] ;
     fhir:type [ fhir:v "boolean" ]
  ] [
     fhir:linkId [ fhir:v "grossesse" ] ;
     fhir:text [ fhir:v "Êtes-vous actuellement enceinte ?" ] ;
     fhir:type [ fhir:v "boolean" ]
  ] [
     fhir:linkId [ fhir:v "allergies" ] ;
     fhir:text [ fhir:v "Avez-vous des allergies connues ?" ] ;
     fhir:type [ fhir:v "boolean" ]
  ] [
     fhir:linkId [ fhir:v "medications" ] ;
     fhir:text [ fhir:v "Prenez-vous des médicaments régulièrement ?" ] ;
     fhir:type [ fhir:v "boolean" ]
  ] ) . # 

