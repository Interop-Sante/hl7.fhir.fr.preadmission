# - resource -------------------------------------------------------------------

<http://hl7.fr/fhir/fr/preadmission/Encounter/encounter-irm-refused> a fhir:Encounter ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "encounter-irm-refused"] ; # 
