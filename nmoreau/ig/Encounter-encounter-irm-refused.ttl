     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Refus de la préadmission par l'agent du bureau des entrées suite à un manque de document - préadmission.</p></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:extension ( [
     fhir:url [ fhir:v "http://hl7.fr/fhir/fr/preadmission/StructureDefinition/statut-preadmission-fr"^^xsd:anyURI ] ;
     fhir:value [
       a fhir:CodeableConcept ;
       fhir:coding ( [
         fhir:system [ fhir:v "http://hl7.fr/fhir/fr/preadmission/CodeSystem/preadmission-status-code-system"^^xsd:anyURI ] ;
         fhir:code [ fhir:v "REFUSED" ]
       ] )
     ]
  ] [
     fhir:url [ fhir:v "http://hl7.fr/fhir/fr/preadmission/StructureDefinition/encounter-agent-instructions"^^xsd:anyURI ] ;
     fhir:value [
       a fhir:string ;
       fhir:v "Le patient n'a pas fourni les documents nécessaires pour valider la préadmission."
     ]
  ] ) ; # 
  fhir:identifier ( [
     fhir:use [ fhir:v "temp" ] ;
     fhir:type [
       fhir:coding ( [
         fhir:system [ fhir:v "http://interopsante.org/fhir/CodeSystem/fr-core-identifier-type"^^xsd:anyURI ] ;
         fhir:code [ fhir:v "VN" ] ;
         fhir:display [ fhir:v "Visit Number" ]
       ] )
     ] ;
     fhir:system [ fhir:v "http://example.com/identifiers/encounters"^^xsd:anyURI ] ;
     fhir:value [ fhir:v "15655244" ]
  ] ) ; # 
  fhir:status [ fhir:v "planned"] ; # 
  fhir:class [
     fhir:system [ fhir:v "http://terminology.hl7.org/CodeSystem/v3-ActCode"^^xsd:anyURI ] ;
     fhir:code [ fhir:v "SS" ] ;
