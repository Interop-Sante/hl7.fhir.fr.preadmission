@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://github.com/Interop-Sante/hl7.fhir.fr.preadmission/Practitioner/practitioner-irm> a fhir:Practitioner ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "practitioner-irm"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Médecin IRM, référencé dans les autres ressources - préadmission.</p></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:identifier ( [
     fhir:system [ fhir:v "http://example.com/practitioner-ids"^^xsd:anyURI ] ;
     fhir:value [ fhir:v "IRM-001" ]
  ] ) ; # 
  fhir:name ( [
     fhir:family [ fhir:v "Martin" ] ;
     fhir:given ( [ fhir:v "Sophie" ] )
  ] ) ; # 
  fhir:gender [ fhir:v "female"] . # 

